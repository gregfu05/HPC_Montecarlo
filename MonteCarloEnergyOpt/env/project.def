Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 python3-pip python3-venv mpi-default-dev libopenmpi-dev && \
    pip3 install --no-cache-dir numpy pyyaml mpi4py && \
    rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C
    export LANG=C
    export PATH=/usr/local/bin:$PATH

%runscript
    exec python3 -m src.main "$@"
